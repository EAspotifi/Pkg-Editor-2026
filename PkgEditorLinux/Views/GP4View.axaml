<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PkgEditorLinux.Views.GP4View">
  <Grid RowDefinitions="Auto,*" Margin="14" RowSpacing="12">
    <Border Classes="card">
      <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="120,*,140,120" ColumnSpacing="10" RowSpacing="8">
        <TextBlock Text="Content ID" Classes="label" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />
        <TextBox x:Name="ContentIdTextBox" Classes="mono" Grid.Row="0" Grid.Column="1" />

        <TextBlock Text="Passcode" Classes="label" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" />
        <TextBox x:Name="PasscodeTextBox" Classes="mono" Grid.Row="1" Grid.Column="1" MaxLength="32" />

        <TextBlock Text="Entitlement Key" Classes="label" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" />
        <TextBox x:Name="EntitlementKeyTextbox" Classes="mono" Grid.Row="2" Grid.Column="1" />

        <ComboBox x:Name="PkgTypeDropdown" Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" HorizontalAlignment="Stretch">
          <ComboBoxItem Content="App (GP)" />
          <ComboBoxItem Content="Patch/DLC (AC Data)" />
          <ComboBoxItem Content="Unlock (AC No-Data)" />
        </ComboBox>

        <Button x:Name="BuildPkgButton" Classes="accent" Content="Build PKG…" Grid.Row="2" Grid.Column="2" />
        <Button x:Name="BuildPfsButton" Content="Build PFS…" Grid.Row="2" Grid.Column="3" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="280,6,*">
      <Border Classes="card" Padding="0" ClipToBounds="True">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Directories" Classes="h3" Margin="14,12,14,6" />
          <TreeView x:Name="DirsTreeView" Margin="6,0,6,8" />
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
      <Border Classes="card" Grid.Column="2" Padding="0" ClipToBounds="True">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Files" Classes="h3" Margin="14,12,14,6" />
          <DataGrid x:Name="FilesGrid" AutoGenerateColumns="False" IsReadOnly="True" Classes="mono" Margin="0,0,0,4">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Target Name" Binding="{Binding TargetName}" Width="220" />
              <DataGridTextColumn Header="Original Path" Binding="{Binding OrigPath}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
