<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PkgEditorLinux.Views.SFOView">
  <Border Classes="card" Margin="10">
    <DataGrid x:Name="SfoGrid" AutoGenerateColumns="False" IsReadOnly="True" Classes="mono">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>
        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/>
        <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="80"/>
        <DataGridTextColumn Header="Max" Binding="{Binding MaxLength}" Width="80"/>
        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
  </Border>
</UserControl>
